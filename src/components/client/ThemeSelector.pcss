.theme-selector-button {
  background: none;
  color: inherit;
  border: none;
  padding: 0;
  cursor: pointer;
  font-family: inherit;
  font-size: 16px;
  font-weight: inherit;
  line-height: inherit;
  text-align: inherit;

  .theme-selector-label {
    display: flex;
    column-gap: 0.4rem;
    align-items: baseline;

    i {
      align-self: center;
      font-size: 13px;
    }
  }
}

.theme-selector-menu {
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 0.4rem;
  background: var(--body-background);
  border-radius: 5px;
  padding: 0;
  font-size: 15px;
  font-weight: 500;
  outline: none;

  li {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    cursor: pointer;
    margin: 0;
    padding: 0.2rem 0.5rem;
    list-style: none;
    color: var(--text-colour);
    border: 2px solid transparent;

    &:first-child {
      border-radius: 5px 5px 0 0;
    }

    &:last-child {
      border-radius: 0 0 5px 5px;
    }

    &:focus-visible {
      border: 2px solid var(--text-colour);
      outline: none;
    }

    &.highlight {
      background: color-mix(
        in srgb,
        var(--body-background) 90%,
        var(--text-colour)
      );
    }

    i {
      font-size: 13px;
    }
  }
}

@import "@/layouts/icons/byb-icon.css";

@font-face {
  font-display: auto;
  font-family: "byb-icon";
  font-style: normal;
  font-weight: 400;

  src: url(./icons/byb-icon.woff2) format(woff2);
}

.byb-icon {
  display: inline-block;
  font-family: "byb-icon";
  font-weight: 400;
  font-style: normal;
  font-variant: normal;
  line-height: 1;
  text-align: center;
}

.byb-icon-mobile-fw {
  width: 1.25em;

  @media (min-width: 600px) {
    width: auto;
  }
}
